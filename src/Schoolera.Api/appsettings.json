{
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=.;Initial Catalog=SchooleraDb;Integrated Security=True;TrustServerCertificate=True"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Swagger": {
    "Enabled": false
  },
  "Database": {
    "ApplyMigrations": false,
    "SeedData": false
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "HttpsRedirection": {
    "Enabled": true
  },
  "Email": {
    "Mode": "Smtp",
    "FromName": "Schoolera",
    "FromAddress": "no-reply@schoolera.local",
    "Smtp": {
      "Host": "",
      "Port": 587,
      "UseSsl": true,
      "Username": "",
      "Password": ""
    }
  },
  "Notifications": {
    "Worker": {
      "BatchSize": 20,
      "PollIntervalSeconds": 5,
      "MaxAttempts": 8,
      "StaleProcessingMinutes": 10,
      "BaseRetrySeconds": 30,
      "MaxRetrySeconds": 3600
    }
  },
  "Meetings": {
    "Worker": {
      "Enabled": true,
      "PollIntervalSeconds": 10
    }
  },
  "Courier": {
    "HealthFreshnessMinutes": 60,
    "HealthFailureAlertThreshold": 3
  },
  "FileStorage": {
    "StorageRoot": "App_Data/uploads",
    "PublicRequestPath": "/uploads",
    "MaxFileSizeBytes": 5242880,
    "AllowedExtensions": [ ".jpg", ".jpeg", ".png", ".webp" ],
    "AllowedContentTypes": [ "image/jpeg", "image/png", "image/webp" ]
  },
  "SchoolPortalMedia": {
    "MaxLogoBytes": 2097152,
    "MaxCoverBytes": 5242880,
    "MaxGalleryImageBytes": 5242880,
    "MaxGeneralGalleryImages": 20,
    "MaxImagesPerStage": 5
  },
  "Nswag": {
    "Enabled": false,
    "SwaggerPath": "/swagger/v1/swagger.json",
    "OutputPath": "Schoolera-SPA/src/app/core/api-client/SwaggerClient.service.ts"
  },
  "PublicSite": {
    "BaseUrl": ""
  },
  "Features": {
    "FavoritesEnabled": false,
    "AdmissionsPlaceholderEnabled": false
  },
  "SupportTickets": {
    "Sla": {
      "ReopenWindowHours": 72,
      "FirstResponseHoursUrgent": 2,
      "FirstResponseHoursHigh": 4,
      "FirstResponseHoursNormal": 24,
      "FirstResponseHoursLow": 48,
      "ResolutionHoursUrgent": 24,
      "ResolutionHoursHigh": 48,
      "ResolutionHoursNormal": 120,
      "ResolutionHoursLow": 240
    }
  },

  "ParentChild": {
    "MinAgeYears": 3,
    "MaxAgeYears": 20
  },
  "ParentIdentityProtection": {
    "HmacKeyBase64": ""
  },
  "AllowedHosts": "*"
}
