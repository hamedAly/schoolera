<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <SpaRoot>$(MSBuildProjectDirectory)\Schoolera-SPA\</SpaRoot>
    <DefaultItemExcludes>$(DefaultItemExcludes);$(SpaRoot)node_modules\**;$(SpaRoot).angular\**;$(SpaRoot)dist\**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MediatR" Version="14.2.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.9">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.OpenApi" Version="2.9.0" />
    <PackageReference Include="NSwag.CodeGeneration.TypeScript" Version="14.7.1" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.1.5" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Schoolera.Application\Schoolera.Application.csproj" />
    <ProjectReference Include="..\Schoolera.Infrastructure\Schoolera.Infrastructure.csproj" />
  </ItemGroup>

  <!-- Keep SPA source in the project tree, but do not publish raw Angular sources. -->
  <ItemGroup>
    <Content Remove="$(SpaRoot)**" />
    <None Include="$(SpaRoot)**" Exclude="$(SpaRoot)node_modules\**;$(SpaRoot).angular\**;$(SpaRoot)dist\**" />
  </ItemGroup>

  <!--
    Builds Angular into wwwroot (see Schoolera-SPA/angular.json outputPath).
    Runs on:
      - dotnet build -c Release
      - dotnet build -p:BuildSpa=true
      - dotnet publish (via AfterTargets ComputeFilesToPublish)
    Skip with -p:SkipSpaBuild=true
  -->
  <Target Name="BuildAngularSpa" BeforeTargets="BeforeBuild" Condition="'$(DesignTimeBuild)' != 'true' And '$(SkipSpaBuild)' != 'true' And ('$(Configuration)' == 'Release' Or '$(BuildSpa)' == 'true')">
    <Message Importance="high" Text="Building Angular SPA into wwwroot..." />
    <Exec WorkingDirectory="$(SpaRoot)" Command="npm ci" Condition="Exists('$(SpaRoot)package-lock.json')" />
    <Exec WorkingDirectory="$(SpaRoot)" Command="npm install" Condition="!Exists('$(SpaRoot)package-lock.json')" />
    <Exec WorkingDirectory="$(SpaRoot)" Command="npm run build" />
    <PropertyGroup>
      <AngularSpaBuilt>true</AngularSpaBuilt>
    </PropertyGroup>
  </Target>

  <Target Name="PublishAngularSpa" AfterTargets="ComputeFilesToPublish" Condition="'$(SkipSpaBuild)' != 'true'">
    <Message Importance="high" Text="Building Angular SPA for publish into wwwroot..." Condition="'$(AngularSpaBuilt)' != 'true'" />
    <Exec WorkingDirectory="$(SpaRoot)" Command="npm ci" Condition="'$(AngularSpaBuilt)' != 'true' And Exists('$(SpaRoot)package-lock.json')" />
    <Exec WorkingDirectory="$(SpaRoot)" Command="npm install" Condition="'$(AngularSpaBuilt)' != 'true' And !Exists('$(SpaRoot)package-lock.json')" />
    <Exec WorkingDirectory="$(SpaRoot)" Command="npm run build" Condition="'$(AngularSpaBuilt)' != 'true'" />

    <!-- Include files created after initial item evaluation. -->
    <ItemGroup>
      <_SpaWwwrootFiles Include="wwwroot\**\*" Exclude="wwwroot\.gitkeep" />
      <ResolvedFileToPublish Include="@(_SpaWwwrootFiles->'%(FullPath)')" Exclude="@(ResolvedFileToPublish)">
        <RelativePath>wwwroot\%(RecursiveDir)%(Filename)%(Extension)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
        <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>

</Project>
